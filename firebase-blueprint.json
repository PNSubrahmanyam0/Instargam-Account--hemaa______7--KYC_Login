{
  "entities": {
    "SecurityActivity": {
      "title": "SecurityActivity",
      "description": "Records security verification events and audit logs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "eventType": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "eventType", "status"]
    }
  },
  "firestore": {
    "/security_activities/{activityId}": {
      "schema": "SecurityActivity",
      "description": "Security audit and status check log collection"
    }
  }
}
