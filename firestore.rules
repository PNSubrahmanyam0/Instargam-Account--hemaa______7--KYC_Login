rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSecurityActivity(data) {
      return data.keys().hasAll(['userId', 'eventType', 'status']) &&
             data.keys().hasOnly(['id', 'userId', 'eventType', 'status', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.eventType is string && data.eventType.size() > 0 && data.eventType.size() <= 64 &&
             data.status is string && data.status.size() > 0 && data.status.size() <= 64 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /security_activities/{activityId} {
      allow get: if isSignedIn() && isValidId(activityId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(activityId) && isValidSecurityActivity(request.resource.data);
      allow update: if isSignedIn() && isValidId(activityId) && isValidSecurityActivity(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && isValidId(activityId) && resource.data.userId == request.auth.uid;
    }
  }
}
